{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js && mkdir -p dist && cp -R *.html products assets robots.txt sitemap.xml dist/ && rm -f dist/design.html dist/.DS_Store dist/_*.html",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
