# Vercel builds from source, then serves dist/ only. Everything here is either
# regenerated by `node build.js` or has no business on a public host.
_probe.*
_iotest.html
_reducetest.html
_diag.html
_mkiotest.js
assets/css/_motion-*.css
*.zip
.DS_Store
plans

# dist/ is generated by the buildCommand in vercel.json, so uploading the local
# copy just doubles the payload — it duplicates all 265 photographs, 11MB of
# the 21.8MB that timed out — and is then overwritten by the build anyway.
dist
.git
node_modules
.env*
